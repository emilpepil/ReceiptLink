{
  "name": "receiptlink",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "npm run contracts:compile",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run contracts:compile && tsc --noEmit && vite build",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "test": "npm run contracts:compile && tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply receiptlink --local",
    "db:remote": "wrangler d1 migrations apply receiptlink --remote",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wagmi": "3.7.7",
    "viem": "2.57.5",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.56.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.2",
    "@cloudflare/workers-types": "5.20261013.1",
    "@vitejs/plugin-react": "6.1.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@openzeppelin/contracts": "5.6.1",
    "ganache": "7.9.2",
    "solc": "0.8.37",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.150.0"
  }
}
